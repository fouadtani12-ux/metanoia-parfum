// METANOÏA PARFUMS - Prisma Schema
// Database Engine: PostgreSQL

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Gender {
  HOMME
  FEMME
  UNISEXE
}

enum FragranceFamily {
  ORIENTAL
  BOISE
  FLORAL
  GOURMAND
  FRAIS
  AMBRE
  CUIRE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum StockMovementReason {
  INITIAL
  ORDER_SALE
  ORDER_CANCELLED
  MANUAL_RESTOCK
  CORRECTION
}

enum NotificationType {
  NEW_ORDER
  LOW_STOCK
  OUT_OF_STOCK
  NEW_USER
  NEW_REVIEW
  ORDER_CANCELLED
}

model User {
  id           String        @id @default(uuid())
  firstName    String
  lastName     String
  email        String        @unique
  phone        String
  passwordHash String?
  role         Role          @default(CUSTOMER)
  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  favorites    Favorite[]
  couponUsages CouponUsage[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("users")
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  phone      String
  address    String
  city       String
  region     String
  postalCode String
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("addresses")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  gender      Gender?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("brands")
}

model Product {
  id              String            @id @default(uuid())
  name            String
  slug            String            @unique
  subtitle        String?
  description     String
  brandId         String?
  brand           Brand?            @relation(fields: [brandId], references: [id])
  categoryId      String?
  category        Category?         @relation(fields: [categoryId], references: [id])
  gender          Gender            @default(UNISEXE)
  price           Decimal           @db.Decimal(10, 2)
  compareAtPrice  Decimal?          @db.Decimal(10, 2)
  discount        Int?
  stock           Int               @default(0)
  sku             String            @unique
  barcode         String            @unique
  volume          String            @default("100 ml")
  fragranceFamily FragranceFamily   @default(ORIENTAL)
  topNotes        String[]
  heartNotes      String[]
  baseNotes       String[]
  isActive        Boolean           @default(true)
  isFeatured      Boolean           @default(false)
  isBestSeller    Boolean           @default(false)
  isNew           Boolean           @default(true)
  rating          Decimal           @default(5.0) @db.Decimal(2, 1)
  reviewCount     Int               @default(0)
  images          ProductImage[]
  orderItems      OrderItem[]
  reviews         Review[]
  favorites       Favorite[]
  inventory       Inventory?
  movements       StockMovement[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("product_images")
}

model Inventory {
  id             String   @id @default(uuid())
  productId      String   @unique
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  currentStock   Int      @default(0)
  minStockAlert  Int      @default(5)
  reservedStock  Int      @default(0)
  availableStock Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@map("inventory")
}

model StockMovement {
  id            String              @id @default(uuid())
  productId     String
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  change        Int
  reason        StockMovementReason
  previousStock Int
  newStock      Int
  operator      String?
  createdAt     DateTime            @default(now())

  @@map("inventory_movements")
}

model Order {
  id             String          @id @default(uuid())
  orderNumber    String          @unique
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName   String
  customerEmail  String
  customerPhone  String
  shippingCity   String
  shippingStreet String
  shippingMethod String          @default("STANDARD")
  subtotal       Decimal         @db.Decimal(10, 2)
  shippingFee    Decimal         @default(0) @db.Decimal(10, 2)
  discountAmount Decimal         @default(0) @db.Decimal(10, 2)
  total          Decimal         @db.Decimal(10, 2)
  paymentMethod  PaymentMethod   @default(COD)
  paymentStatus  PaymentStatus   @default(PENDING)
  status         OrderStatus     @default(PENDING)
  items          OrderItem[]
  payment        Payment?
  couponUsages   CouponUsage[]
  timeline       OrderTimeline[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  volume    String
  createdAt DateTime @default(now())

  @@map("order_items")
}

model OrderTimeline {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  label       String
  note        String?
  isCompleted Boolean     @default(false)
  timestamp   DateTime?
  createdAt   DateTime    @default(now())

  @@map("order_timelines")
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(10, 2)
  transactionId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("payments")
}

model ShippingRate {
  id            String   @id @default(uuid())
  city          String   @unique
  standardFee   Decimal  @db.Decimal(10, 2)
  expressFee    Decimal  @db.Decimal(10, 2)
  estimatedDays String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("shipping_methods")
}

model Coupon {
  id              String        @id @default(uuid())
  code            String        @unique
  type            CouponType    @default(PERCENTAGE)
  value           Decimal       @db.Decimal(10, 2)
  minimumAmount   Decimal       @default(0) @db.Decimal(10, 2)
  maximumDiscount Decimal?      @db.Decimal(10, 2)
  startDate       DateTime
  endDate         DateTime
  usageLimit      Int           @default(100)
  usageCount      Int           @default(0)
  isActive        Boolean       @default(true)
  usages          CouponUsage[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("coupons")
}

model CouponUsage {
  id       String   @id @default(uuid())
  couponId String
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId  String
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  usedAt   DateTime @default(now())

  @@map("coupon_usages")
}

model Review {
  id               String   @id @default(uuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName         String
  rating           Int
  comment          String
  status           String   @default("APPROVED")
  verifiedPurchase Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("reviews")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("favorites")
}

model Notification {
  id        String           @id @default(uuid())
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@map("notifications")
}

model Setting {
  id                     String   @id @default(uuid())
  storeName              String   @default("METANOÏA PARFUMS")
  tagline                String   @default("Une signature olfactive qui vous ressemble.")
  email                  String
  phone                  String
  instagram              String   @default("@metanoia.parfums")
  freeShippingThreshold  Decimal  @default(500) @db.Decimal(10, 2)
  currency               String   @default("DH")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("settings")
}
